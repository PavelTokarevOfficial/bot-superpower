{
  "name": "bot-superpower",
  "version": "1.0.0",
  "private": true,
  "description": "Bun Telegram bot that invents funny drawbacks for superpowers",
  "type": "module",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --packages=bundle --minify --sourcemap=linked",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test"
  },
  "dependencies": {
    "grammy": "^1.38.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
